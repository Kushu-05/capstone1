# ==============================================================================
# AI Powered Document Summarization & Voice Generation - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider & Model Fallback Configuration
# ------------------------------------------------------------------------------
# Primary LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Fallback LLM Provider (used if primary provider fails): "ollama", "gemini", or "none"
FALLBACK_LLM_PROVIDER=ollama

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# Google Gemini Configuration (Primary Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Ollama Local LLM Configuration (Local Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30

# Retry and Timeout Limits
MAX_RETRIES=2
LLM_TIMEOUT=15

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Storage Paths & Limits
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
AUDIO_DIR=./data/audio
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=document_chunks
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg,webp,bmp,tiff,tif,mp3,wav,m4a,ogg

# S3-Compatible Object Storage (Optional, "local" is default)
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=us-east-1

# ------------------------------------------------------------------------------
# 4. Chunking, Vector Embeddings & Hybrid Retrieval Configuration
# ------------------------------------------------------------------------------
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=250
FALLBACK_CHUNK_SIZE_CHARS=750
FALLBACK_CHUNK_OVERLAP_CHARS=100
MAX_CHUNK_TOKEN_CEILING=900
TOP_K_CHUNKS=5

# Semantic Embedding Model
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# Hybrid Retrieval (hybrid = ChromaDB dense + BM25 Okapi sparse + RRF)
RETRIEVAL_MODE=hybrid
RRF_K=60

# Local Reranking Model
ENABLE_RERANKING=True
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ------------------------------------------------------------------------------
# 5. Document Extraction & Layout-Aware Configuration
# ------------------------------------------------------------------------------
ENABLE_OCR_FALLBACK=True
ENABLE_DOCLING=True

# ------------------------------------------------------------------------------
# 6. Text-to-Speech (TTS) Provider & Fallback Configuration
# ------------------------------------------------------------------------------
PRIMARY_TTS_PROVIDER=edge_tts
FALLBACK_TTS_PROVIDER=gtts
ENABLE_TTS_FALLBACK=True

# Default Voice Mappings
DEFAULT_TTS_VOICE_EN=en-US-JennyNeural
DEFAULT_TTS_VOICE_HI=hi-IN-SwaraNeural
DEFAULT_TTS_VOICE_KN=kn-IN-SapnaNeural
DEFAULT_TTS_VOICE_TA=ta-IN-PallaviNeural
